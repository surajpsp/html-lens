{
  // HTML Lens website + web app (/app) — static assets on Cloudflare Workers (no backend code).
  "name": "htmllens",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "htmllens.silentdev.online", "custom_domain": true }],
  "workers_dev": true
}
